# ==============================================================================
# AxonVortex Environment Variables Configuration Template
# ==============================================================================
# Copy this file to .env.local for local development.
# NEVER commit .env or .env.local containing real credentials to version control.
# ==============================================================================

# Public Site Configuration
# The canonical public URL of the deployed application
NEXT_PUBLIC_SITE_URL=https://axon-vortex.vercel.app

# Inbound Intake / Contact Routing (Optional)
# Target email recipient or webhook for consultation submissions from /contact
CONTACT_NOTIFICATION_EMAIL=consultation@axonvortex.com
CONTACT_WEBHOOK_URL=

# Analytics & Performance (Optional)
# NEXT_PUBLIC_ANALYTICS_ID=
